<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="windmill_ugv_suspension">
  <!-- V1 deliberately uses rigid wheel mounts. The interfaces below reserve the mechanical architecture for a later compliant suspension without introducing unstable free joints. -->
  <xacro:property name="suspension_ready" value="true"/>
</robot>
