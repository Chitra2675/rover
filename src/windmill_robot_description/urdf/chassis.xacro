<?xml version="1.0"?>
<!--
  chassis.xacro
  =============
  Main chassis body, underbody skid plate, and electronics enclosure.

  Key geometry fix:
    chassis_bottom_z = 0.210 m
    wheel_radius     = 0.100 m  → wheel top = 0.200 m
    → 10 mm clearance between wheel top and chassis bottom. No intersection.

  TF:
    base_footprint → base_link → chassis_link
    base_link → underbody_skid_link
    base_link → electronics_enclosure_link
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="windmill_ugv_chassis">

  <!-- Box inertia helper -->
  <xacro:macro name="inertial_box" params="mass x y z xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(y*y+z*z)}" ixy="0" ixz="0"
        iyy="${mass/12.0*(x*x+z*z)}" iyz="0"
        izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       base_footprint — Nav2 ground-plane reference
  ============================================================ -->
  <link name="base_footprint"/>

  <!-- ============================================================
       base_link — primary robot reference frame at ground level
  ============================================================ -->
  <link name="base_link">
    <!-- Physical chassis geometry lives here.
         Visual/collision centre at chassis_centre_z above ground. -->
    <xacro:inertial_box
      mass="${chassis_mass}"
      x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"
      xyz="0 0 ${chassis_centre_z}"/>

    <!-- Main body box -->
    <visual>
      <origin xyz="0 0 ${chassis_centre_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_centre_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Front accent stripe (visual only, makes front direction obvious) -->
    <visual>
      <origin xyz="${chassis_length/2.0 - 0.005} 0 ${chassis_centre_z}" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="red_accent"/>
    </visual>

  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- chassis_link: fixed alias of base_link (Nav2 compatibility) -->
  <link name="chassis_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       UNDERBODY SKID PLATE
       Sits just below chassis bottom — protective aluminium sheet.
  ============================================================ -->
  <link name="underbody_skid_link">
    <xacro:inertial_box
      mass="${underbody_mass}"
      x="${underbody_length}" y="${underbody_width}" z="${underbody_thickness}"
      xyz="0 0 ${chassis_bottom_z - underbody_thickness/2.0}"/>
    <visual>
      <origin xyz="0 0 ${chassis_bottom_z - underbody_thickness/2.0}"/>
      <geometry>
        <box size="${underbody_length} ${underbody_width} ${underbody_thickness}"/>
      </geometry>
      <material name="metal_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_bottom_z - underbody_thickness/2.0}"/>
      <geometry>
        <box size="${underbody_length} ${underbody_width} ${underbody_thickness}"/>
      </geometry>
    </collision>
  </link>
  <joint name="underbody_skid_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="underbody_skid_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       ELECTRONICS ENCLOSURE
       Visible box on top of chassis representing the electronics bay.
       Depth = 40 mm, sits flush on chassis top.
  ============================================================ -->
  <link name="electronics_enclosure_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${misc_mass}"/>
      <inertia
        ixx="${misc_mass/12.0*(enclosure_width*enclosure_width + 0.040*0.040)}"
        ixy="0" ixz="0"
        iyy="${misc_mass/12.0*(enclosure_length*enclosure_length + 0.040*0.040)}"
        iyz="0"
        izz="${misc_mass/12.0*(enclosure_length*enclosure_length + enclosure_width*enclosure_width)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.020"/>
      <geometry>
        <box size="${enclosure_length} ${enclosure_width} 0.040"/>
      </geometry>
      <material name="landing_dark"/>
    </visual>
    <!-- No collision — sits inside chassis envelope -->
  </link>
  <joint name="electronics_enclosure_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="electronics_enclosure_link"/>
    <origin xyz="-0.020 0 ${chassis_top_z}" rpy="0 0 0"/>
  </joint>

</robot>
