<?xml version="1.0"?>
<!--
  materials.xacro
  ===============
  Visual material definitions for RViz and Gazebo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="windmill_ugv_materials">

  <!-- Chassis / structure -->
  <material name="chassis_gray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="metal">
    <color rgba="0.60 0.62 0.65 1.0"/>
  </material>
  <material name="metal_dark">
    <color rgba="0.30 0.32 0.35 1.0"/>
  </material>

  <!-- Wheels -->
  <material name="rubber_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="wheel_hub">
    <color rgba="0.50 0.50 0.55 1.0"/>
  </material>

  <!-- Landing platform -->
  <material name="landing_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>
  <material name="landing_dark">
    <color rgba="0.18 0.18 0.20 1.0"/>
  </material>
  <material name="post_silver">
    <color rgba="0.70 0.72 0.75 1.0"/>
  </material>

  <!-- Sensors -->
  <material name="sensor_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.10 0.30 0.80 1.0"/>
  </material>

  <!-- Electronics -->
  <material name="electronics_green">
    <color rgba="0.10 0.50 0.20 1.0"/>
  </material>
  <material name="electronics_blue">
    <color rgba="0.10 0.20 0.70 1.0"/>
  </material>
  <material name="battery_color">
    <color rgba="0.15 0.35 0.65 1.0"/>
  </material>
  <material name="orange_comp">
    <color rgba="0.90 0.45 0.05 1.0"/>
  </material>

  <!-- Special -->
  <material name="coil_copper">
    <color rgba="0.85 0.50 0.10 1.0"/>
  </material>
  <material name="fiducial_white">
    <color rgba="1.00 1.00 1.00 1.0"/>
  </material>
  <material name="gps_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="red_accent">
    <color rgba="0.80 0.10 0.10 1.0"/>
  </material>

</robot>
