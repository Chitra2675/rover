<?xml version="1.0"?>
<!--
  wheel.xacro
  ===========
  Parametric drive wheel + motor macro instantiated six times.

  Each wheel:
    - Cylinder with axis along Y (rotates around Y-axis)
    - Visual: split into outer tyre (black, full radius) + hub disc (silver)
    - Motor placeholder inboard of wheel
    - Joint named ${name}_wheel_joint (continuous)

  Inertia (solid cylinder, spin axis = Y):
    Ixx = Izz = m/12*(3r² + h²)   (bending axes)
    Iyy       = m/2 * r²           (spin axis)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="windmill_ugv_wheels">

  <!-- Cylinder inertia helper (axis along Y after visual rotation) -->
  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(3.0*radius*radius + width*width)}"
        ixy="0" ixz="0"
        iyy="${mass/2.0*radius*radius}"
        iyz="0"
        izz="${mass/12.0*(3.0*radius*radius + width*width)}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       DRIVE WHEEL MACRO
       params:
         name  — prefix (front_left, middle_left, etc.)
         x     — wheel centre X from base_link
         y     — wheel centre Y (+left, -right)
         z     — wheel centre Z (= wheel_radius for ground contact)
         side  — "left" or "right" (sets motor offset direction)
  ============================================================ -->
  <xacro:macro name="drive_wheel" params="name x y z side motor_sign">

    <!-- TYRE: outer rubber cylinder, full radius -->
    <link name="${name}_wheel">
      <xacro:wheel_inertial mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>

      <!-- Outer tyre — black rubber -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_black"/>
      </visual>

      <!-- Hub disc — silver, slightly inset -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.55}" length="${wheel_width * 0.35}"/>
        </geometry>
        <material name="wheel_hub"/>
      </visual>

      <!-- Collision uses full tyre size -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.0" velocity="25.0"/>
      <dynamics damping="0.15" friction="0.05"/>
    </joint>

    <!-- MOTOR PLACEHOLDER: fixed joint, inboard of wheel -->
    <link name="${name}_motor">
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <mass value="${motor_mass}"/>
        <inertia
          ixx="${motor_mass/12.0*(motor_length*motor_length + 4*motor_radius*motor_radius)}"
          ixy="0" ixz="0"
          iyy="${motor_mass/2.0*motor_radius*motor_radius}"
          iyz="0"
          izz="${motor_mass/12.0*(motor_length*motor_length + 4*motor_radius*motor_radius)}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${motor_radius}" length="${motor_length}"/>
        </geometry>
        <material name="metal_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${motor_radius}" length="${motor_length}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_motor_fixed_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_motor"/>
      <!-- Motor sits inboard: left side shifts +Y, right side shifts -Y.
           Since y is already +/- signed, multiply by 0 and add fixed offset
           in the correct direction using the signed y value as reference. -->
      <origin
        xyz="${x} ${y + motor_sign * (0.5*wheel_width + 0.5*motor_length)} ${z}"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
